# HARNESS_URL=http://127.0.0.1:9191
# FEE_HTTP_URL=http://127.0.0.1:9193

PERP_MARKET_INDEX=0
PERP_ORDER_MARKET_INDEX=0
PERP_ORDER_SIDE=bid
PERP_ORDER_PRICE=100
PERP_ORDER_QUANTITY=0.01
PERP_ORDER_MAX_QUOTE_QUANTITY=
PERP_ORDER_CLIENT_ORDER_ID=
PERP_INTENT_CLIENT_ORDER_ID=
