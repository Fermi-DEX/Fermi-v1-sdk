CONTINUUM_DEPLOYMENT=
CLUSTER=devnet
CLUSTER_URL=https://api.devnet.solana.com
PROGRAM_ID=
USER_KEYPAIR=/absolute/path/to/id.json
GROUP_PK=GROUP_PUBKEY
MANGO_ACCOUNT_PK=MANGO_ACCOUNT_PUBKEY
MANGO_ACCOUNT_NUM=0
MANGO_ACCOUNT_NAME=
EXECUTION_QUEUE_PK=EXECUTION_QUEUE_PUBKEY
RELAYER_ADDR=relayer.example.com:9190
RELAYER_MAX_FEE_LAMPORTS=AUTO
HARNESS_URL=http://relayer-host.example.com:9191
FEE_HTTP_URL=http://relayer-host.example.com:9193
USDC_MINT=
USDC_AMOUNT_UI=10
WITHDRAW_ALLOW_BORROW=false

# Mainnet production shortcut:
# CONTINUUM_DEPLOYMENT=fermi-r6-mainnet
# CLUSTER=mainnet-beta
# CLUSTER_URL=https://api.mainnet-beta.solana.com
# PROGRAM_ID=FRMiKrj2hQGvcZQtSDdiFRZ4cmaTjuc1QVkM2B5ShUvA
# GROUP_PK=87qUKYQoK1f9gYQjYzw5NcRo7wx6VmfhTGJ7JenoeYAA
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
