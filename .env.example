# ── Fermi proxy gateway ───────────────────────────────────────────────────────
# REST, gRPC, and streams use the gateway. The API key is mandatory
# and is sent as the `x-api-key` header (HTTP) / metadata (gRPC). The proxy
# uses it for identity + per-key rate limiting.
FERMI_API_URL=https://v1.fermi.trade/prod
FERMI_API_GRPC_ADDR=v1.fermi.trade:443
FERMI_API_KEY=<enter api key>

RELAYER_MAX_FEE_LAMPORTS=AUTO
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
