PERP_ORDER_SELF_TRADE_BEHAVIOR=decrementTake
PERP_ORDER_REDUCE_ONLY=false
PERP_ORDER_EXPIRY_TIMESTAMP=0
PERP_ORDER_MATCH_LIMIT=10
PERP_ORDER_MIN_EXECUTE_SLOT=
PERP_ORDER_EXPIRES_AT_SLOT=
PERP_ORDER_MAX_FEE_LAMPORTS=AUTO
DIRECT_ORDER_MARKET_INDEX=0
DIRECT_ORDER_SIDE=bid
DIRECT_ORDER_PRICE=100
DIRECT_ORDER_QUANTITY=0.01
DIRECT_ORDER_MAX_QUOTE_QUANTITY=
DIRECT_ORDER_CLIENT_ORDER_ID=
DIRECT_ORDER_TYPE=postOnlySlide
DIRECT_ORDER_SELF_TRADE_BEHAVIOR=decrementTake
DIRECT_ORDER_REDUCE_ONLY=false
DIRECT_ORDER_EXPIRY_TIMESTAMP=0
DIRECT_ORDER_MATCH_LIMIT=10
DIRECT_ORDER_EXPIRES_AT_SLOT=
DIRECT_ORDER_NONCE=
BOT_SIDE=bid
BOT_SPREAD_BPS=20
BOT_SIZE=0.01
BOT_INTERVAL_MS=2000
BOT_MAX_FEE_LAMPORTS=AUTO
COINGECKO_ASSET_ID=solana
COINGECKO_VS_CURRENCY=usd

# ── simulate / portfolio scripts ──────────────────────────────────────────────
# Used by `npm run simulate` and `npm run portfolio`. The harness's in-process
# /simulate cache has a default 15s TTL; the simulate script auto-warms via
# POST /simulate/warm before every run, but a real UI should warm once per
# trade-modal open and let subsequent keystrokes hit cache directly.
OWNER=
SIMULATE_OWNER=
SIMULATE_MANGO_ACCOUNT=
SIMULATE_MARKET=SOL-PERP
SIMULATE_SIDE=buy
SIMULATE_QUANTITY=1
SIMULATE_PRICE=
SIMULATE_ORDER_TYPE=limit
SIMULATE_REDUCE_ONLY=false
VIEW=optimistic

# ── smoke-check probes ────────────────────────────────────────────────────────
# Optional: setting USER_OWNER_PK lets smoke-check query a real /fees/status
# balance instead of just probing the fee server's /healthz.
USER_OWNER_PK=
