{
  "name": "@fermilabs/continuum-sdk",
  "version": "0.1.1",
  "private": true,
  "description": "Self-contained SDK for Mango relayer quoting, Continuum harness reads, and direct chain interactions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "continuum-quoter": "./dist/bin/run-quoter.js",
    "continuum-create-mango-account": "./dist/bin/create-mango-account.js",
    "continuum-deposit-usdc": "./dist/bin/deposit-usdc.js",
    "continuum-direct-place-order": "./dist/bin/direct-orders/place.js",
    "continuum-smoke-check": "./dist/bin/smoke-check.js",
    "continuum-simulate": "./dist/bin/simulate.js",
    "continuum-portfolio": "./dist/bin/portfolio.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "proto",
    "fee_system.md",
    "intent_reference.md",
    "README.md",
    "USAGE.md",
    "src/bin/direct-orders/README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "validate": "npm run typecheck && npm run build && npm pack --dry-run",
    "create-mango-account": "ts-node src/bin/create-mango-account.ts",
    "deposit-usdc": "ts-node src/bin/deposit-usdc.ts",
    "direct-place-order": "ts-node src/bin/direct-orders/place.ts",
    "smoke-check": "ts-node src/bin/smoke-check.ts",
    "simulate": "ts-node src/bin/simulate.ts",
    "portfolio": "ts-node src/bin/portfolio.ts"
  },
  "dependencies": {
    "@blockworks-foundation/mango-v4": "^0.24.0",
    "@coral-xyz/anchor": "^0.29.0",
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@solana/web3.js": "^1.78.2",
    "dotenv": "^16.0.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  }
}
